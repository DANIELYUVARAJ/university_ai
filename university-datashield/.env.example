# University DataShield — Environment Configuration Template
# Copy to .env and configure for your deployment environment.
# DO NOT commit real secrets or credentials to source control.

# Application Environment (development | production | testing)
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Networking & Host
HOST=0.0.0.0
PORT=8000
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Database Connection (SQLite local prototype or PostgreSQL production)
# SQLite: sqlite:///data/datashield.db
# PostgreSQL: postgresql+asyncpg://<pg_user>:<pg_password>@<pg_host>:5432/<pg_database>
DATABASE_URL=sqlite:///data/datashield.db

# Downstream PostgreSQL Analytics Destination (Phase 12 Enterprise Data Mart)
# Leave empty for local development / test mode. Configure for production data warehouse export.
# Format: postgresql://<analytics_user>:<analytics_password>@<analytics_host>:5432/<analytics_database>
POSTGRES_ANALYTICS_URL=
POSTGRES_SCHEMA=analytical_mart
POSTGRES_POOL_MIN_SIZE=2
POSTGRES_POOL_MAX_SIZE=10
POSTGRES_SSL_MODE=prefer

# Authentication (OAuth2 / OIDC Token Verification)
# Set to 'true' in production to enforce Bearer token verification on all protected endpoints.
AUTH_ENABLED=false
AUTH_ISSUER=https://auth.university.edu
AUTH_AUDIENCE=university-datashield
AUTH_ALGORITHM=HS256
AUTH_SECRET_KEY=CHANGE_THIS_TO_A_CRYPTOGRAPHICALLY_RANDOM_KEY_AT_LEAST_32_CHARS
TOKEN_EXPIRE_MINUTES=60

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120

# Ingestion Security & Resource Limits
MAX_UPLOAD_SIZE_MB=15
MAX_JSON_DEPTH=10
MAX_RECORDS_INGEST=100000

# Asynchronous Worker & Pipeline Queue
WORKER_CONCURRENCY=4
WORKER_MAX_QUEUE_SIZE=1000
WORKER_JOB_TIMEOUT_SECONDS=300

# Audit Security
AUDIT_CHAIN_STRICT=true

# Phase 13: Local LLM Assistant (Optional Ollama for Demo / Viva)
# Set to 'true' to enable the Assistant. Uses local Ollama server if running.
LLM_ASSISTANT_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=15.0
LLM_MAX_PROMPT_CHARS=2000
